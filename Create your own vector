//User defined data structure 
           //(Create your own vector)
           //topic-06
class Vector{
public:
 int size;
 int capacity;
 int*arr;

Vector() {    //V
size=0;
capacity=1;
arr=new int[1];
}
 void add(int ele){
 if(size==capacity){
 capacity*=2;
 int*arr2=new int(capacity);
 for(int i=0; i<size; i++){
 arr2[i]=arr[i];
} 
delete[] arr;  //imp. 
arr=arr2;
 }
 arr[size++]=ele;
  }
  
  
  void print(){
  if(size==0){
cout << "Array is Empty" << endl;
}
for(int i=0; i<size; i++){
cout << arr[i]<< " ";
}
cout << endl;
}

  
int get(int idx){
if(size==0){
cout << "Array is Empty" << endl;
return -1;
}
if (idx>=size || idx<0){
cout << " Invalid index" << endl;
return -1;
}
return -1;
 } 
 
 
void remove(){
if(size==0){
cout << "Array is Empty" << endl;
}
size--;
 }
};
